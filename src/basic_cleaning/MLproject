name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Wandb artifact reference for raw CSV data (e.g., "sample.csv:latest")
        type: string

      output_artifact:
        description: Name of the output artifact to save cleaned data in Wandb (e.g., "cleaned_data.csv")
        type: string

      output_type:
        description: Artifact type for tracking (e.g., "cleaned_data")
        type: string

      output_description:
        description: Description of the cleaning process and transformations applied
        type: string

      min_price:
        description: Minimum price threshold (in USD) to filter out unrealistic low prices
        type: float

      max_price:
        description: Maximum price threshold (in USD) to filter out unrealistic high prices
        type: float


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
